# Файл примера переменных окружения
# Скопируйте этот файл в .env и настройте значения для вашего окружения

# ==============================================
# ОБЩИЕ НАСТРОЙКИ
# ==============================================

# Режим работы (development, production, test)
NODE_ENV=development

# Часовой пояс
TZ=Europe/Moscow

# ==============================================
# БАЗЫ ДАННЫХ
# ==============================================

# MongoDB подключение
MONGO_URI=mongodb://localhost:27017
MONGO_AUTH_DB=warehouse_auth
MONGO_INVENTORY_DB=warehouse_inventory
MONGO_TRACKING_DB=warehouse_tracking
MONGO_NOTIFICATIONS_DB=warehouse_notifications

# MongoDB аутентификация (если требуется)
MONGO_USERNAME=
MONGO_PASSWORD=

# ==============================================
# БЕЗОПАСНОСТЬ
# ==============================================

# JWT секретный ключ (измените для production!)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_256_bit_key

# Время жизни токенов
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Ключ шифрования (32 символа для AES-256)
ENCRYPTION_KEY=your_encryption_key_32_characters_

# Bcrypt cost (10-12 для production)
BCRYPT_COST=12

# ==============================================
# СЕРВИСЫ - ПОРТЫ
# ==============================================

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Auth Service
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_URL=http://localhost:8000

# Warehouse Service
WAREHOUSE_SERVICE_PORT=8001
WAREHOUSE_SERVICE_URL=http://localhost:8001

# Tracking Service
TRACKING_SERVICE_PORT=8002
TRACKING_SERVICE_URL=http://localhost:8002

# Notification Service
NOTIFICATION_SERVICE_PORT=8003
NOTIFICATION_SERVICE_URL=http://localhost:8003

# Analytics Service
ANALYTICS_SERVICE_PORT=8004
ANALYTICS_SERVICE_URL=http://localhost:8004

# ==============================================
# MESSAGE BROKER
# ==============================================

# RabbitMQ настройки
RABBITMQ_URI=amqp://guest:guest@localhost:5672/
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Management UI
RABBITMQ_MANAGEMENT_PORT=15672

# ==============================================
# BLOCKCHAIN
# ==============================================

# Ethereum node URL (Ganache для разработки)
ETH_NODE_URL=http://localhost:8545
ETH_NETWORK_ID=1337

# Ethereum accounts (Ganache автоматически создает)
ETH_ACCOUNT_PRIVATE_KEY=0x...
ETH_ACCOUNT_ADDRESS=0x...

# Contract address (заполняется автоматически при deploy)
ETH_CONTRACT_ADDRESS=

# Gas settings
ETH_GAS_LIMIT=6721975
ETH_GAS_PRICE=20000000000

# ==============================================
# EMAIL УВЕДОМЛЕНИЯ
# ==============================================

# SMTP настройки
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email отправителя
EMAIL_FROM=noreply@warehouse-system.local
EMAIL_FROM_NAME=Warehouse Management System

# ==============================================
# FRONTEND НАСТРОЙКИ
# ==============================================

# API URLs для frontend
NEXT_PUBLIC_API_AUTH_URL=http://localhost:8000
NEXT_PUBLIC_API_WAREHOUSE_URL=http://localhost:8001
NEXT_PUBLIC_API_TRACKING_URL=http://localhost:8002
NEXT_PUBLIC_API_NOTIFICATION_URL=http://localhost:8003

# App настройки
NEXT_PUBLIC_APP_NAME=Warehouse Management System
NEXT_PUBLIC_APP_VERSION=1.0.0

# Google Analytics (если нужно)
NEXT_PUBLIC_GA_ID=

# ==============================================
# CORS И БЕЗОПАСНОСТЬ
# ==============================================

# Разрешенные origins для CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CORS_ALLOW_CREDENTIALS=true

# Разрешенные headers
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# ==============================================
# RATE LIMITING
# ==============================================

# Rate limiting настройки
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Специальные лимиты для аутентификации
AUTH_RATE_LIMIT_WINDOW=15m
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ==============================================
# ЛОГИРОВАНИЕ
# ==============================================

# Уровень логирования (debug, info, warn, error)
LOG_LEVEL=info

# Формат логов (json, text)
LOG_FORMAT=json

# Файлы логов
LOG_FILE_PATH=./logs/app.log
LOG_ERROR_FILE_PATH=./logs/error.log

# Ротация логов
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=5
LOG_MAX_AGE=7d

# ==============================================
# МОНИТОРИНГ И МЕТРИКИ
# ==============================================

# Health check settings
HEALTH_CHECK_TIMEOUT=30s
HEALTH_CHECK_INTERVAL=1m

# Prometheus metrics (если используется)
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# ==============================================
# РАЗВЕРТЫВАНИЕ
# ==============================================

# Docker настройки
DOCKER_REGISTRY=
DOCKER_TAG=latest

# Kubernetes namespace (если используется)
K8S_NAMESPACE=warehouse-system

# ==============================================
# FEATURE FLAGS
# ==============================================

# Включение/выключение функций
ENABLE_BLOCKCHAIN=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true

# ==============================================
# РАЗРАБОТКА
# ==============================================

# Debug режим
DEBUG=false

# Hot reload для разработки
HOT_RELOAD=true

# Автоматическая загрузка demo данных
AUTO_LOAD_DEMO_DATA=true

# Swagger UI (включить в разработке)
ENABLE_SWAGGER=true

# ==============================================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ==============================================

# Connection pool настройки
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=1h

# Cache TTL
CACHE_TTL=5m
CACHE_CLEANUP_INTERVAL=10m

# Request timeout
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s

# ==============================================
# ФАЙЛОВОЕ ХРАНИЛИЩЕ
# ==============================================

# Локальное хранилище файлов
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# S3 (если используется)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=warehouse-files

# ==============================================
# ИНТЕГРАЦИИ
# ==============================================

# External APIs
EXTERNAL_API_KEY=
EXTERNAL_API_URL=

# Webhooks
WEBHOOK_SECRET=your_webhook_secret_key

# ==============================================
# РЕЗЕРВНОЕ КОПИРОВАНИЕ
# ==============================================

# Автоматическое резервное копирование
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ==============================================
# SSL/TLS (для production)
# ==============================================

# SSL сертификаты
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CA_PATH=

# HTTPS redirect
FORCE_HTTPS=false

# ==============================================
# ЛОКАЛИЗАЦИЯ
# ==============================================

# Язык по умолчанию
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,en

# Формат даты/времени
DATE_FORMAT=DD.MM.YYYY
TIME_FORMAT=HH:mm:ss
TIMEZONE=Europe/Moscow

# ==============================================
# АНАЛИТИКА И ОТЧЕТЫ
# ==============================================

# Отчеты
REPORTS_PATH=./reports
REPORTS_RETENTION_DAYS=90

# Экспорт данных
EXPORT_PATH=./exports
EXPORT_MAX_RECORDS=10000

# ==============================================
# УВЕДОМЛЕНИЯ
# ==============================================

# Типы уведомлений
NOTIFICATION_TYPES=email,push,sms,in_app

# Шаблоны уведомлений
NOTIFICATION_TEMPLATES_PATH=./templates/notifications

# Delay между уведомлениями
NOTIFICATION_DELAY=1s
NOTIFICATION_RETRY_COUNT=3

# ==============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ==============================================

# Часовой пояс базы данных
DB_TIMEZONE=UTC

# Максимальный размер запроса
MAX_REQUEST_SIZE=10MB

# Timeout для внешних API
EXTERNAL_API_TIMEOUT=30s

# Количество worker'ов для фоновых задач
WORKER_POOL_SIZE=10
